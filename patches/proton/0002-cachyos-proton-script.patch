+@dataclass
+class VulkanExtensionProperties:
+    extensionName: str
+    specVersion: int
+
+    @classmethod
+    def from_native_obj(cls, properties: VkExtensionProperties) -> Self:
+        return cls(
+            properties.extensionName.decode(),
+            properties.specVersion,
+        )
