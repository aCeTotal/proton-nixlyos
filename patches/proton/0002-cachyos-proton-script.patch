+
+class VulkanPhysicalDeviceFeatures(set):
+    def __init__(self, arg):
+        super().__init__(arg)
+
+    @classmethod
+    def from_native_obj(cls, features: Structure):
+        return cls(
+            name
+            for name, dtype in features._fields_
+            if dtype == VkBool32 and bool(getattr(features, name))
+        )
