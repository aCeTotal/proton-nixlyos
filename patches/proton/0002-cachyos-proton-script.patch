+# https://docs.vulkan.org/spec/latest/chapters/features.html#vkGetPhysicalDeviceFeatures2
+class VkPhysicalDeviceFeatures2(Structure):
+    _fields_ = [
+        ('sType', c_int),
+        ('pNext', c_void_p),
+        ('features', VkPhysicalDeviceFeatures)
+    ]
